#!/bin/sh
#MISE description="Set up the whole environment (mise, dotfiles, tools, prompt, zsh plugins, terminal)"
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/lib/common.sh"

# Preflight: check everything we cannot install ourselves before touching any file.
platform="$(uname -s) $(uname -m)"
case $platform in
  "Darwin arm64" | "Linux x86_64" | "Linux aarch64" | "Linux arm64") ;;
  *) die "unsupported platform: $platform (supported: macOS on Apple silicon, Linux x86_64 or arm64)" ;;
esac
for cmd in curl tar zsh; do
  command -v "$cmd" >/dev/null 2>&1 ||
    die "$cmd is required but not installed (for example: sudo apt install $cmd)"
done

for task in self dotfiles tools prompt zsh-plugins terminal; do
  "$MISE" run "$task"
done
cat <<'MSG'

Done. Per-machine steps that are deliberately not automated:
  - git config --global user.name / user.email
  - sbx login              (Docker Sandboxes)
  - claude / codex         (each signs in on first run)
  - exec zsh               (or open a new terminal)
Anything personal belongs in ~/.zshrc.local, which mise-me never touches.
Replaced files are kept under ~/.local/state/mise-me/backups.
MSG
