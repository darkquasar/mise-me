#!/bin/sh
#MISE description="Write the stock starship gruvbox-rainbow preset"
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$here
until [ -f "$root/lib/common.sh" ]; do
  [ "$root" != / ] || { echo "error: cannot find lib/common.sh" >&2; exit 1; }
  root=$(dirname "$root")
done
. "$root/lib/common.sh"
base=$(dirname "$here")
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
(cd "$HOME" && "$MISE" exec -- starship preset gruvbox-rainbow -o "$tmp/starship.toml")
# starship reads STARSHIP_CONFIG or ~/.config/starship.toml (not XDG_CONFIG_HOME).
install_file "$tmp/starship.toml" "${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
