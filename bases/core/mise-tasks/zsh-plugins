#!/bin/sh
#MISE description="Download fzf-tab, zsh-autosuggestions and zsh-syntax-highlighting (pinned, checksummed)"
# Tarballs rather than git clones: no .git folder, so the local git identity
# is never written into the plugin folders.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$here
until [ -f "$root/lib/common.sh" ]; do
  [ "$root" != / ] || { echo "error: cannot find lib/common.sh" >&2; exit 1; }
  root=$(dirname "$root")
done
. "$root/lib/common.sh"
base=$(dirname "$here")
dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

plugin() {
  name=$1 repo=$2 tag=$3 sha=$4
  dest="$dir/$name"
  if [ -f "$dest/.mise-me-tag" ] && [ "$(cat "$dest/.mise-me-tag")" = "$tag" ]; then
    log "$name already at $tag"
    return 0
  fi
  # Download and unpack fully before touching the existing folder.
  fetch "https://github.com/$repo/archive/refs/tags/$tag.tar.gz" "$sha" "$tmp/$name.tar.gz"
  mkdir -p "$tmp/$name"
  tar -xzf "$tmp/$name.tar.gz" -C "$tmp/$name"
  staged=$(find "$tmp/$name" -mindepth 1 -maxdepth 1 -type d)
  [ -n "$staged" ] && [ -d "$staged" ] || die "unexpected archive layout for $name"
  printf '%s\n' "$tag" > "$staged/.mise-me-tag"
  mkdir -p "$dir"
  move_aside "$dest"
  mv "$staged" "$dest"
  log "$name at $tag"
}
